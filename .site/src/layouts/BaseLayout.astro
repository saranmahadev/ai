---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "AI Learning Path",
  description = "A structured path through artificial intelligence, from foundations to systems you can build.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4eee5" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
