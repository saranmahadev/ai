#!/bin/sh
# Runs the full site check suite before a push leaves this machine, but only for the
# dev and main branches — feature/* branches push straight through for fast iteration
# and get checked when they're merged into dev (see "Branching and release flow" in
# CLAUDE.md). Enabled by `git config core.hooksPath .githooks` (wired automatically by
# `npm ci`'s `prepare` script in .site/package.json). Skip once with `git push --no-verify`.
set -e
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
case "$branch" in
  feature/*)
    exit 0
    ;;
esac

zero="0000000000000000000000000000000000000000"
has_content=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "$zero" ]; then
    has_content=1
  fi
done
if [ "$has_content" -eq 0 ]; then
  # Every ref in this push is a deletion — nothing to build or test.
  exit 0
fi

cd "$(git rev-parse --show-toplevel)/.site"
npm test
npm run content
npm run test:site
npm run test:reader
npm run test:planet
npm run test:benches
